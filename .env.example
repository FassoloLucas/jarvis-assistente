# Copie este arquivo pra ".env" (na raiz do projeto) e preencha com os
# valores de verdade. O ".env" nunca vai pro git (está no .gitignore) —
# esse ".env.example" é só o modelo, sem segredo nenhum.

# Chave da API da OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Connection string do MongoDB Atlas (Connect -> Drivers, com a senha já
# no lugar de <password>) — ver README, "Memória compartilhada"
MONGODB_URI=
MONGODB_DB=jarvis

# Só o backend hospedado usa isso (JWT dos logins do app) — gere uma
# string aleatória longa, ex: openssl rand -hex 32
JARVIS_JWT_SECRET=

# Perfil neutro; configure apenas em sua instalação
JARVIS_NOME=Usuário de demonstração
JARVIS_EMAIL=
JARVIS_MODEL_ID=openai/gpt-4o-mini
JARVIS_CLIMA_LAT=-23.5505
JARVIS_CLIMA_LON=-46.6333
JARVIS_CLIMA_CIDADE=São Paulo, SP
